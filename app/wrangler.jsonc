{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Little Bean on your own Cloudflare account.
  // Before the first deploy, replace REPLACE_WITH_YOUR_D1_DATABASE_ID below with
  // the id that `wrangler d1 create little-bean-db` prints (see README.md).
  "name": "little-bean",

  // `vite build` writes the server bundle here (TanStack Start SSR Worker).
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static files in dist/client are served directly; every other path goes to
  // the Worker. Do not set run_worker_first:true.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "vars": { "HF_ENV": "production", "APP_SLUG": "little-bean" },

  // D1 database: products, orders, customers, settings, admin logins…
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "little-bean-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // R2 bucket: product photos and logos uploaded in admin, payment slips.
  "r2_buckets": [{ "binding": "STORAGE", "bucket_name": "little-bean-media" }]
}
